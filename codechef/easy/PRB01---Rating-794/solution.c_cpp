#include <stdio.h>

int main() {
	// your code goes here
	int t;
	scanf("%d",&t);
	while(t>0)
	{
	    t--;
	    int i,flag=0;
	    long long n;
	    scanf("%lld",&n);
	    if(n<=1)
	    {
	        printf("no\n");
	        continue;
	    }
	    for(i=2;i*i<=n;i++)
	    {
	        if(n%i==0)
	        {
	            flag=1;
	            break;
	        }
	        
	    }
	    if(flag==1)
	    printf("no\n");
	    else
	    printf("yes\n");
	    
	}
	return 0;

}

